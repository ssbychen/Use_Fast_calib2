<?xml version="1.0"?>
<package format="3">
  <name>use_fast_calib2_ros2</name>
  <version>0.0.0</version>
  <description>Minimal ROS2 (Humble) package demonstrating a header-only SVD solver.</description>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <exec_depend>rclcpp</exec_depend>
  <!-- Eigen is header-only; use system package libeigen3-dev that provides Eigen3Config.cmake -->
  <build_depend>eigen3_cmake_module</build_depend>
  <exec_depend>eigen3_cmake_module</exec_depend>

  <maintainer email="you@example.com">your name</maintainer>
</package>
